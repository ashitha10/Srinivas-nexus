rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{eventId} {
      allow read, write: if true;
    }
    match /announcements/{announcementId} {
      allow read, write: if true;
    }
    match /registrations/{registrationId} {
      allow read, write: if true;
    }
  }
}
